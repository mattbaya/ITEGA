{
  "_comment": "Publisher C's home base. Imported at Keycloak startup so the realm is reproducible rather than hand-configured. Two things here are load-bearing: every client sets subjectType=pairwise, which is what makes a reader a different opaque person at each publisher; and the newshare-network-userid-mapper carries homeBaseId HB001 into the token. Secrets are placeholders and MUST be replaced before deployment.",
  "realm": "publisher-c",
  "enabled": true,
  "displayName": "Publisher C Home Base",
  "registrationAllowed": true,
  "registrationEmailAsUsername": true,
  "resetPasswordAllowed": true,
  "loginTheme": "keycloak",
  "_comment_sessions": "SSO session idle governs how long a reader stays recognised here. Kept comfortably longer than the ALS session token (30 min) so a live demo does not hit a re-login mid-walkthrough.",
  "ssoSessionIdleTimeout": 3600,
  "ssoSessionMaxLifespan": 36000,
  "accessTokenLifespan": 300,
  "clients": [
    {
      "clientId": "pub-a",
      "name": "Publisher A",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "REPLACE-ME-PUB-A",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://als.itega.org/auth/callback"
      ],
      "webOrigins": [
        "https://als.itega.org"
      ],
      "attributes": {
        "pubMbrId": "ITEGA-PA-0001",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "pairwise subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sha256-pairwise-sub-mapper",
          "consentRequired": false,
          "config": {
            "sectorIdentifierUri": "",
            "pairwiseSubAlgorithmSalt": "REPLACE-ME-SALT-A"
          }
        },
        {
          "name": "newshare network claims",
          "protocol": "openid-connect",
          "protocolMapper": "newshare-network-userid-mapper",
          "consentRequired": false,
          "config": {
            "homeBaseId": "HB001",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "pub-b",
      "name": "Publisher B",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "REPLACE-ME-PUB-B",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "https://als.itega.org/auth/callback"
      ],
      "webOrigins": [
        "https://als.itega.org"
      ],
      "attributes": {
        "pubMbrId": "ITEGA-PB-0001",
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "pairwise subject",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sha256-pairwise-sub-mapper",
          "consentRequired": false,
          "config": {
            "sectorIdentifierUri": "",
            "pairwiseSubAlgorithmSalt": "REPLACE-ME-SALT-B"
          }
        },
        {
          "name": "newshare network claims",
          "protocol": "openid-connect",
          "protocolMapper": "newshare-network-userid-mapper",
          "consentRequired": false,
          "config": {
            "homeBaseId": "HB001",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "_comment_users": "Demo readers. networkGroupId is the subscription-tier bitmask the mapper reads: 4096 = Paid Subscriber, 2 = Registered. Two tiers so the demo can show one reader whose subscription covers an article and another who has to buy it.",
  "users": [
    {
      "username": "susan@example.org",
      "email": "susan@example.org",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Susan",
      "lastName": "Reader",
      "attributes": {
        "networkGroupId": [
          "4096"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "REPLACE-ME-DEMO-PASSWORD",
          "temporary": false
        }
      ]
    },
    {
      "username": "tom@example.org",
      "email": "tom@example.org",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Tom",
      "lastName": "Reader",
      "attributes": {
        "networkGroupId": [
          "2"
        ]
      },
      "credentials": [
        {
          "type": "password",
          "value": "REPLACE-ME-DEMO-PASSWORD",
          "temporary": false
        }
      ]
    }
  ]
}
